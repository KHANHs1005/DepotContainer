@*
    Layout chính dùng cho giao diện DepotContainer.WebUI
    Dựa trên bố cục sidebar bên trái theo mẫu HTML bạn gửi.
*@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DepotContainer.WebUI</title>

    <!-- Bootstrap & CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />   
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/globals.css" asp-append-version="true" />
</head>
<body>
    <div class="trang-ch d-flex">
        <!-- Sidebar -->
        <div class="navbar d-flex flex-column align-items-center p-3" style="width: 250px; background-color: #f8f9fa; border-right: 1px solid #ddd;">
            <div class="rectangle mb-3"></div>

            <div class="group text-center mb-3">
                <img class="user mb-2" src="~/img/user.png" alt="User" width="60" />
                <div class="text-wrapper fw-bold">ĐÀM DUY KHÁNH</div>
            </div>

            <img class="line my-3" src="~/img/line-1.svg" alt="Line" width="100%" />

            <ul class="nav flex-column text-center w-100">
                <li class="nav-item my-2">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                        <img src="~/img/Warehouse.jpg" width="100" class="me-2" /> Dashboard
                    </a>
                </li>
                <li class="nav-item my-2">
                    <a class="nav-link text-dark" asp-controller="Container" asp-action="Index">
                        <img src="~/img/shipping-container.png" width="24" class="me-2" /> Container
                    </a>
                </li>
                <li class="nav-item my-2">
                    <a class="nav-link text-dark" asp-controller="Booking" asp-action="Index">
                        <img src="~/img/document.png" width="24" class="me-2" /> Booking
                    </a>
                </li>
                <li class="nav-item my-2">
                    <a class="nav-link text-dark" asp-controller="Notification" asp-action="Index">
                        <img src="~/img/bell.png" width="24" class="me-2" /> Thông báo
                    </a>
                </li>
                <li class="nav-item my-2">
                    <a class="nav-link text-dark" asp-controller="Setting" asp-action="Index">
                        <img src="~/img/settings.png" width="24" class="me-2" /> Cài đặt
                    </a>
                </li>
            </ul>

            <div class="mt-auto ng-xut text-center">
                <a class="text-danger nav-link" asp-controller="Account" asp-action="Logout">
                    <img class="logout me-2" src="~/img/logout.png" width="24" /> Đăng xuất
                </a>
            </div>
        </div>

        <!-- Main content -->
        <div class="flex-grow-1 p-4" style="overflow-y: auto;">
            <main role="main">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted text-center mt-4 py-3">
                &copy; 2025 - DepotContainer.WebUI
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
