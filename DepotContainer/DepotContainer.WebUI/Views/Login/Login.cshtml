@model DepotContainer.WebUI.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Đăng nhập";
}

<div class="login-form">
    <h1>ĐĂNG NHẬP</h1>

    @using (Html.BeginForm("Login", "Login", FormMethod.Post))
    {
        <label for="Username">Tài khoản</label>
        @Html.TextBoxFor(m => m.Username, new { placeholder = "Nhập tài khoản" })

        <label for="Password">Mật khẩu</label>
        @Html.PasswordFor(m => m.Password, new { placeholder = "Nhập mật khẩu" })

        <button type="submit">Đăng nhập</button>

        @if (ViewBag.Error != null)
        {
            <p style="color:red; margin-top:15px;">@ViewBag.Error</p>
        }
    }
</div>
